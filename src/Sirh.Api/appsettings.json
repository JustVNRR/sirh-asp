{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Jwt": {
    "SigningKey": "",
    "Issuer": "Sirh.Api",
    "Audience": "Sirh.Clients",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "Identity": {
    "AutoMigrate": false,
    "SeedOnStartup": true,
    "SeedDemoUsers": false
  },
  "RateLimiting": {
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60
  },
  "Email": {
    "Enabled": false,
    "Host": "localhost",
    "Port": 1025,
    "FromAddress": "no-reply@sirh.local",
    "FromName": "SIRH Platform",
    "UseSsl": false
  },
  "Encryption": {
    "MasterKey": ""
  },
  "Storage": {
    "Provider": "Local",
    "LocalRootPath": "./storage",
    "MaxFileSizeBytes": 20971520
  },
  "Organization": {
    "AutoMigrate": false,
    "SeedOnStartup": true,
    "SeedDemoData": false
  },
  "HumanResources": {
    "AutoMigrate": false
  },
  "HealthChecks": {
    "SkipDatabase": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
