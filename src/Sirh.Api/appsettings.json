{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Encryption": {
    "MasterKey": ""
  },
  "Storage": {
    "Provider": "Local",
    "LocalRootPath": "./storage",
    "MaxFileSizeBytes": 20971520
  },
  "HealthChecks": {
    "SkipDatabase": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
