{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Jwt": {
    "SigningKey": "",
    "Issuer": "Sirh.Api",
    "Audience": "Sirh.Clients",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "Identity": {
    "AutoMigrate": false,
    "SeedOnStartup": true,
    "SeedDemoUsers": false
  },
  "RateLimiting": {
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60
  },
  "Encryption": {
    "MasterKey": ""
  },
  "Storage": {
    "Provider": "Local",
    "LocalRootPath": "./storage",
    "MaxFileSizeBytes": 20971520
  },
  "HealthChecks": {
    "SkipDatabase": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
